---
interface Props {
  id: string;
  class?: string;
  variant?: 'gradient' | 'solid';
}

const {
  id,
  class: className = 'h-8 w-8',
  variant = 'gradient',
} = Astro.props;

const paths: Record<string, string> = {
  'machine-learning':
    'M4 20V10M10 20V4M16 20v-6M22 20H2',
  'data-analytics':
    'M4 19V9M10 19V5M16 19v-7M22 19H2',
  'automation':
    'M12 3a9 9 0 1 0 9 9M12 3a9 9 0 0 1 9 9M12 7v5l3 2',
  'app-development':
    'M8 4h8a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1ZM12 18h.01',
};

const gradientId = `sg-${id}`;
---

<svg
  class:list={[className]}
  fill="none"
  stroke={variant === 'gradient' ? `url(#${gradientId})` : 'currentColor'}
  viewBox="0 0 24 24"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    variant === 'gradient' && (
      <defs>
        <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#0EA5E9" />
          <stop offset="100%" stop-color="#3069B4" />
        </linearGradient>
      </defs>
    )
  }
  <path d={paths[id]}></path>
</svg>
