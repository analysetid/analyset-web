---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/case-study/', label: 'Case Study' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href.replace(/\/$/, ''));
};
---

<header
  {...Astro.props}
  id="site-header"
  class="sticky top-0 z-50 bg-white/85 backdrop-blur-xl transition-all duration-300 border-b border-sky-100"
>
  <nav class="max-w-7xl mx-auto px-4 md:px-8" aria-label="Navigasi utama">
    <div class="flex items-center justify-between h-14 md:h-16">
      <a href="/" class="flex items-center shrink-0" aria-label="Analyset — Beranda">
        <img
          src="/logos/analyset-logo.png"
          alt="Logo Analyset"
          class="h-8 md:h-10 w-auto"
        />
      </a>

      <div class="hidden lg:flex items-center gap-5 xl:gap-6">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'relative text-sm font-medium transition-colors',
                'after:absolute after:left-0 after:-bottom-1.5 after:h-0.5 after:rounded-full after:transition-all after:duration-300',
                isActive(link.href)
                  ? 'text-primary after:w-full after:bg-brand-gradient'
                  : 'text-gray-600 hover:text-primary after:w-0 after:bg-primary hover:after:w-full',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="https://wa.me/6281363663754"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-brand-gradient text-white rounded-xl px-6 py-3 font-medium transition-all duration-300 text-sm shadow-lg shadow-primary/25 hover:-translate-y-0.5"
        >
          Konsultasi Gratis
        </a>
      </div>

      <button
        id="menu-toggle"
        type="button"
        aria-label="Buka menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="lg:hidden inline-flex items-center justify-center p-2 rounded-lg text-gray-600 hover:text-primary hover:bg-sky-50 transition-colors"
      >
        <svg
          id="icon-open"
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="icon-close"
          class="h-6 w-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden pb-4">
      <div class="glass rounded-2xl p-3 flex flex-col gap-1">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'block px-4 py-3 rounded-xl text-base font-medium transition-colors',
                isActive(link.href)
                  ? 'bg-sky-50 text-primary'
                  : 'text-gray-600 hover:bg-sky-50 hover:text-primary',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="https://wa.me/6281363663754"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 bg-brand-gradient text-white rounded-xl px-6 py-3 font-medium transition-all duration-300 text-center shadow-lg shadow-primary/25"
        >
          Konsultasi Gratis
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const header = document.getElementById('site-header');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle?.setAttribute('aria-expanded', String(!isOpen));
  });

  const onScroll = () => {
    const scrolled = window.scrollY > 8;
    if (!header) return;
    if (scrolled) {
      header.classList.add('bg-white/95', 'shadow-md', 'shadow-sky-100');
      header.classList.remove('bg-white/85');
    } else {
      header.classList.add('bg-white/85');
      header.classList.remove('bg-white/95', 'shadow-md', 'shadow-sky-100');
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
