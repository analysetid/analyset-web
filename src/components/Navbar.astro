---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/case-study/', label: 'Case Study' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href.replace(/\/$/, ''));
};
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-gray-100">
  <nav class="max-w-7xl mx-auto px-4 md:px-8" aria-label="Navigasi utama">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a href="/" class="flex items-center shrink-0" aria-label="Analyset — Beranda">
        <img
          src="/logos/analyset-logo.png"
          alt="Logo Analyset"
          class="h-9 md:h-11 w-auto"
        />
      </a>

      <div class="hidden lg:flex items-center gap-6 xl:gap-8">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'text-sm font-medium transition-colors hover:text-primary',
                isActive(link.href)
                  ? 'text-primary'
                  : 'text-neutral-dark',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="/contact/"
          class="bg-primary text-white rounded-lg px-6 py-3 font-medium hover:bg-primary-dark transition-colors text-sm"
        >
          Konsultasi Gratis
        </a>
      </div>

      <button
        id="menu-toggle"
        type="button"
        aria-label="Buka menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="lg:hidden inline-flex items-center justify-center p-2 rounded-lg text-neutral-dark hover:text-primary hover:bg-gray-100 transition-colors"
      >
        <svg
          id="icon-open"
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="icon-close"
          class="h-6 w-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden pb-6">
      <div class="flex flex-col gap-1">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'block px-4 py-3 rounded-lg text-base font-medium transition-colors',
                isActive(link.href)
                  ? 'bg-primary/5 text-primary'
                  : 'text-neutral-dark hover:bg-gray-100',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="/contact/"
          class="mt-3 bg-primary text-white rounded-lg px-6 py-3 font-medium hover:bg-primary-dark transition-colors text-center"
        >
          Konsultasi Gratis
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle?.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
