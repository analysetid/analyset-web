---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: Date;
  tags?: string[];
  image?: string;
}

const { href, title, excerpt, date, tags = [], image } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---

<article
  class="group relative overflow-hidden rounded-[1.5rem] bg-white border border-sky-100 flex flex-col h-full shadow-md transition-all duration-300 hover:-translate-y-1.5 hover:border-sky-300 hover:shadow-lg"
>
  <a href={href} class="block overflow-hidden">
    {image ? (
      <img
        src={image}
        alt={`Gambar artikel ${title}`}
        class="w-full h-36 object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div
        class="relative w-full h-36 bg-cyan-gradient flex items-center justify-center overflow-hidden"
      >
        <div class="absolute inset-0 bg-grid-light opacity-40" aria-hidden="true"></div>
        <img src="/favicon.png" alt="Ikon Analyset" class="relative h-10 w-10" />
      </div>
    )}
  </a>
  <div class="p-5 flex flex-col flex-1">
    <div class="flex flex-wrap gap-2 mb-3">
      {tags.map((tag) => (
        <span
          class="text-xs font-medium text-primary bg-sky-50 border border-sky-200 rounded-full px-3 py-1"
        >
          {tag}
        </span>
      ))}
    </div>
    <a href={href} class="block">
      <h3
        class="text-lg md:text-xl font-semibold text-neutral-dark leading-snug group-hover:text-primary transition-colors"
      >
        {title}
      </h3>
    </a>
    <time datetime={date.toISOString()} class="mt-2 text-sm text-gray-500">
      {formattedDate}
    </time>
    <p class="mt-2 text-sm text-gray-600 leading-relaxed line-clamp-3">
      {excerpt}
    </p>
    <a
      href={href}
      class="mt-3 text-sm font-medium text-primary hover:text-primary-dark transition-colors"
    >
      Baca selengkapnya →
    </a>
  </div>
</article>
