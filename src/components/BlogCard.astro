---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: Date;
  tags?: string[];
  image?: string;
}

const { href, title, excerpt, date, tags = [], image } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---

<article class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow overflow-hidden flex flex-col h-full">
  <a href={href} class="block">
    {image ? (
      <img
        src={image}
        alt={`Gambar artikel ${title}`}
        class="w-full h-44 object-cover"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-44 bg-brand-gradient flex items-center justify-center">
        <img
          src="/favicon.png"
          alt="Ikon Analyset"
          class="h-10 w-10"
        />
      </div>
    )}
  </a>
  <div class="p-6 flex flex-col flex-1">
    <div class="flex flex-wrap gap-2 mb-3">
      {tags.map((tag) => (
        <span class="text-xs font-medium text-primary bg-primary/10 rounded-full px-3 py-1">
          {tag}
        </span>
      ))}
    </div>
    <a href={href} class="block group">
      <h3 class="text-lg md:text-xl font-semibold text-neutral-dark leading-snug group-hover:text-primary transition-colors">
        {title}
      </h3>
    </a>
    <time datetime={date.toISOString()} class="mt-2 text-sm text-neutral-dark/60">
      {formattedDate}
    </time>
    <p class="mt-3 text-sm text-neutral-dark/70 leading-relaxed line-clamp-3">
      {excerpt}
    </p>
    <a
      href={href}
      class="mt-4 text-sm font-medium text-primary hover:text-primary-dark transition-colors"
    >
      Baca selengkapnya →
    </a>
  </div>
</article>
