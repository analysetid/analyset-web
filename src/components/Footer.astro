---
const serviceLinks = [
  { label: 'Pembuatan Model Machine Learning', href: '/services/#machine-learning' },
  { label: 'Implementasi Data Analytics', href: '/services/#data-analytics' },
  { label: 'Automation', href: '/services/#automation' },
  { label: 'Pengembangan Aplikasi', href: '/services/#app-development' },
];

const companyLinks = [
  { label: 'Tentang Kami', href: '/about/' },
  { label: 'Studi Kasus', href: '/case-study/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Hubungi Kami', href: '/contact/' },
];
---

<footer {...Astro.props} class="bg-brand-gradient text-white relative overflow-hidden">
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sky-300/60 to-transparent"
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 bg-grid-light opacity-30" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 md:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      <div>
        <img
          src="/logos/analyset-logo-bw.png"
          alt="Logo Analyset"
          class="h-10 w-auto"
        />
        <p class="mt-4 text-sm text-white/85 leading-relaxed">
          One-Stop Data Solution untuk Korporat
        </p>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-sky-100 mb-4">
          <span class="mr-3 inline-block h-4 w-1 rounded-full bg-sky-400 align-middle" aria-hidden="true"></span>Layanan
        </h2>
        <ul class="space-y-2">
          {
            serviceLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-white/85 hover:text-white hover:underline underline-offset-4 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-sky-100 mb-4">
          <span class="mr-3 inline-block h-4 w-1 rounded-full bg-sky-400 align-middle" aria-hidden="true"></span>Perusahaan
        </h2>
        <ul class="space-y-2">
          {
            companyLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-white/85 hover:text-white hover:underline underline-offset-4 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-sky-100 mb-4">
          <span class="mr-3 inline-block h-4 w-1 rounded-full bg-sky-400 align-middle" aria-hidden="true"></span>Kontak
        </h2>
        <ul class="space-y-2 text-sm text-white/85">
          <li>
            <a
              href="mailto:central@analyset.com"
              class="hover:text-white hover:underline underline-offset-4 transition-colors"
            >
              central@analyset.com
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/6287855572616"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white hover:underline underline-offset-4 transition-colors"
            >
              +62 878-5557-2616
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-white/20">
      <p class="text-sm text-white/80">
        © 2026 Analyset. All rights reserved.
      </p>
    </div>
  </div>
</footer>
