---
interface Props {
  title: string;
  buttonLabel?: string;
  href?: string;
}

const {
  title,
  buttonLabel = 'Hubungi Kami Sekarang',
  href = '/contact/',
} = Astro.props;
---

<section class="py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <div
      class="relative overflow-hidden rounded-[2.5rem] glass-strong glow-cyan px-6 md:px-12 py-10 md:py-12 text-center text-white"
    >
      <div class="absolute inset-0 bg-starfield opacity-60" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-grid-space opacity-60" aria-hidden="true"></div>
      <div
        class="absolute -top-20 -left-20 h-64 w-64 rounded-full bg-cyan-400/15 blur-3xl"
        aria-hidden="true"
      ></div>
      <div
        class="absolute -bottom-24 -right-16 h-72 w-72 rounded-full bg-primary/40 blur-3xl"
        aria-hidden="true"
      ></div>
      <div class="relative">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold leading-tight max-w-3xl mx-auto">
          {title}
        </h2>
        <a
          href={href}
          class="mt-6 inline-block bg-white text-space-900 rounded-xl px-8 py-3 font-semibold hover:glow-cyan hover:-translate-y-0.5 transition-all duration-300"
        >
          {buttonLabel}
        </a>
      </div>
    </div>
  </div>
</section>
