---
interface Props {
  title: string;
  buttonLabel?: string;
  href?: string;
}

const {
  title,
  buttonLabel = 'Hubungi Kami Sekarang',
  href = '/contact/',
} = Astro.props;
---

<section class="py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <div class="bg-brand-gradient rounded-2xl px-6 md:px-12 py-12 md:py-16 text-center text-white">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold leading-tight max-w-3xl mx-auto">
        {title}
      </h2>
      <a
        href={href}
        class="mt-8 inline-block bg-white text-primary rounded-lg px-8 py-3 font-medium hover:bg-neutral-light transition-colors"
      >
        {buttonLabel}
      </a>
    </div>
  </div>
</section>
