---
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/CtaSection.astro';
import BlogCard from '../../components/BlogCard.astro';
import HeroBubbles from '../../components/HeroBubbles.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(post.data.pubDate);

const siteUrl = 'https://analyset.com';
const articleUrl = `${siteUrl}/blog/${post.slug}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  image: `${siteUrl}${post.data.image ?? '/og-image.png'}`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: articleUrl },
  ],
};

const relatedPosts = (await getCollection('blog'))
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.image ?? '/og-image.png'}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <article>
    <header class="relative overflow-hidden bg-gradient-to-b from-sky-50 to-white py-12 md:py-16">
      <div class="absolute inset-0 bg-dots" aria-hidden="true"></div>
      <HeroBubbles />
      <div class="relative max-w-3xl mx-auto px-4 md:px-8">
        <div class="flex flex-wrap gap-2 mb-4">
          {
            post.data.tags.map((tag) => (
              <span class="text-xs font-medium text-primary bg-sky-50 border border-sky-200 rounded-full px-3 py-1">
                {tag}
              </span>
            ))
          }
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-neutral-dark leading-tight">
          {post.data.title}
        </h1>
        <div class="mt-5 flex items-center gap-3 text-sm text-gray-500">
          <span class="font-medium text-neutral-dark">{post.data.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        </div>
        <div class="mt-5">
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(articleUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Bagikan artikel ini ke LinkedIn"
            class="inline-flex items-center gap-2 rounded-full border border-sky-200 bg-white px-4 py-2 text-sm font-medium text-primary transition-colors hover:bg-sky-50 hover:border-sky-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.114 20.452H3.558V9h3.556v11.452z" />
            </svg>
            Bagikan ke LinkedIn
          </a>
        </div>
      </div>
    </header>

    <div class="py-10 md:py-12 bg-white">
      <div class="max-w-3xl mx-auto px-4 md:px-8">
        <div class="article-content">
          <Content />
        </div>
      </div>
    </div>
  </article>

  {
    relatedPosts.length > 0 && (
      <section class="pb-12 md:pb-16 bg-sky-50">
        <div class="max-w-7xl mx-auto px-4 md:px-8">
          <span class="block h-1 w-16 rounded-full bg-brand-gradient" aria-hidden="true"></span>
          <h2 class="mt-4 text-2xl md:text-3xl font-semibold text-neutral-dark">
            Artikel Lainnya
          </h2>
          <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            {
              relatedPosts.map((p) => (
                <BlogCard
                  href={`/blog/${p.slug}/`}
                  title={p.data.title}
                  excerpt={p.data.description}
                  date={p.data.pubDate}
                  tags={p.data.tags}
                  image={p.data.image}
                />
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  <CtaSection
    title="Ingin tahu lebih lanjut bagaimana kami bisa membantu bisnis Anda?"
    buttonLabel="Hubungi Kami"
  />
</Layout>
