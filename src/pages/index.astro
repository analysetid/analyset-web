---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import CtaSection from '../components/CtaSection.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import BlogCard from '../components/BlogCard.astro';
import { services } from '../data/services';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestPosts = posts.slice(0, 3);
---

<Layout
  title="Konsultan Data Analytics Indonesia"
  description="Analyset membantu korporat menengah mengolah data menjadi keputusan bisnis — via machine learning, data analytics, automation & aplikasi. Konsultasi gratis."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-gradient text-white">
    <div class="absolute inset-0 bg-grid-light opacity-40" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-dots-light opacity-30" aria-hidden="true"></div>
    <div
      class="absolute -top-24 -left-24 h-96 w-96 rounded-full bg-primary/30 blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="absolute -bottom-32 right-0 h-[28rem] w-[28rem] rounded-full bg-white/10 blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="relative max-w-7xl mx-auto px-4 md:px-8 py-16 md:py-24 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="animate-fade-in-up">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-1.5 text-xs md:text-sm font-medium text-white/90 backdrop-blur">
          <span class="h-1.5 w-1.5 rounded-full bg-white" aria-hidden="true"></span>
          Konsultan Data Analytics
        </span>
        <h1 class="mt-6 text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-white">
          Ubah Data Perusahaan Anda Menjadi Keputusan Bisnis yang
          <span class="text-gradient-light">Lebih Cerdas</span>
        </h1>
        <p class="mt-6 text-base md:text-lg text-white/80 leading-relaxed max-w-xl">
          Analyset membantu korporat menengah mengolah data menjadi rekomendasi
          bisnis nyata — melalui data analytics, machine learning, automation,
          dan pengembangan aplikasi.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/contact/"
            class="bg-white text-primary rounded-lg px-6 py-3 font-medium hover:glow hover:-translate-y-0.5 transition-all duration-300"
          >
            Konsultasi Gratis
          </a>
          <a
            href="/services/"
            class="border-2 border-white/60 text-white rounded-lg px-6 py-3 font-medium hover:bg-white/10 hover:border-white transition-all duration-300"
          >
            Lihat Layanan
          </a>
        </div>
      </div>

      <div class="hidden lg:block animate-fade-in-up delay-200">
        <div class="relative rounded-2xl bg-white/10 backdrop-blur-lg border border-white/20 p-6 md:p-8 glow">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-white"></span>
              <span class="text-sm font-medium text-white">Dashboard Analitik</span>
            </div>
            <span class="text-xs font-medium text-white bg-white/15 border border-white/20 rounded-full px-3 py-1">
              Real-time
            </span>
          </div>
          <div class="flex items-end justify-between gap-3 h-40">
            <div class="w-full bg-white/15 rounded-t-lg h-16"></div>
            <div class="w-full bg-white/25 rounded-t-lg h-24"></div>
            <div class="w-full bg-white/30 rounded-t-lg h-20"></div>
            <div class="w-full bg-white/45 rounded-t-lg h-32"></div>
            <div class="w-full bg-white/55 rounded-t-lg h-28"></div>
            <div class="w-full bg-white rounded-t-lg h-40"></div>
          </div>
          <div class="mt-6 grid grid-cols-3 gap-4">
            <div class="rounded-lg bg-white/10 border border-white/10 p-4">
              <p class="text-xs text-white/70">Waktu dihemat</p>
              <p class="mt-1 text-xl font-bold text-white">100 jam</p>
            </div>
            <div class="rounded-lg bg-white/10 border border-white/10 p-4">
              <p class="text-xs text-white/70">Akurasi data</p>
              <p class="mt-1 text-xl font-bold text-white">99%</p>
            </div>
            <div class="rounded-lg bg-white/10 border border-white/10 p-4">
              <p class="text-xs text-white/70">Proses otomatis</p>
              <p class="mt-1 text-xl font-bold text-white">4+</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="relative py-16 md:py-24">
    <div class="absolute inset-0 bg-dots opacity-40" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <span class="mx-auto block h-1 w-16 rounded-full bg-brand-gradient" aria-hidden="true"></span>
        <h2 class="mt-5 text-3xl md:text-4xl font-semibold text-neutral-dark">
          Layanan Kami
        </h2>
        <p class="mt-4 text-base md:text-lg text-neutral-dark/70">
          Empat lini layanan yang dirancang untuk membantu korporat menengah
          mengoptimalkan data mereka.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {
          services.map((service) => (
            <div class="group relative bg-white rounded-2xl card-shadow border border-gray-100 p-6 md:p-8 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-xl hover:shadow-primary/10 overflow-hidden">
              <span class="absolute inset-x-0 top-0 h-1 bg-brand-gradient opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></span>
              <div class="flex items-center justify-between">
                <div class="rounded-xl bg-primary/10 p-3 transition-colors duration-300 group-hover:bg-brand-gradient">
                  <ServiceIcon id={service.id} class="h-8 w-8 text-primary transition-colors duration-300 group-hover:text-white" />
                </div>
                <span class="text-primary transition-transform duration-300 group-hover:translate-x-1">→</span>
              </div>
              <h3 class="mt-5 text-xl md:text-2xl font-semibold text-neutral-dark group-hover:text-primary transition-colors">
                {service.title}
              </h3>
              <p class="mt-3 text-base text-neutral-dark/70 leading-relaxed">
                {service.description}
              </p>
              <a
                href={`/services/#${service.id}`}
                class="mt-5 inline-block text-sm font-medium text-primary hover:text-primary-dark transition-colors"
              >
                Pelajari lebih lanjut →
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Case Study Highlight -->
  <section class="py-16 md:py-24 bg-neutral-light">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="bg-white rounded-2xl card-shadow overflow-hidden grid grid-cols-1 lg:grid-cols-2">
        <div class="relative bg-brand-gradient p-8 md:p-12 flex flex-col justify-center text-white overflow-hidden">
          <div class="absolute inset-0 bg-grid-light opacity-40" aria-hidden="true"></div>
          <div class="absolute -top-16 -right-16 h-64 w-64 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
          <div class="relative">
            <p class="text-sm font-medium uppercase tracking-wider text-white/80">
              Studi Kasus
            </p>
            <p class="mt-4 text-4xl md:text-5xl font-bold leading-tight text-white">
              100 Jam Kerja/Minggu Dihemat
            </p>
            <p class="mt-4 text-white/85 leading-relaxed">
              Kopi Kenangan — Automation Rekonsiliasi Keuangan
            </p>
          </div>
        </div>
        <div class="p-8 md:p-12 flex flex-col justify-center">
          <span class="block h-1 w-16 rounded-full bg-brand-gradient" aria-hidden="true"></span>
          <h2 class="mt-5 text-2xl md:text-3xl font-semibold text-neutral-dark">
            Kopi Kenangan
          </h2>
          <p class="mt-4 text-base md:text-lg text-neutral-dark/70 leading-relaxed">
            Kami membantu Kopi Kenangan mengotomatisasi proses rekonsiliasi
            keuangan, memangkas waktu kerja manual secara signifikan setiap
            minggunya.
          </p>
          <a
            href="/case-study/"
            class="mt-6 inline-block text-primary font-medium hover:text-primary-dark transition-colors"
          >
            Baca Studi Kasus Lengkap →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Analyset -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="block h-1 w-16 rounded-full bg-brand-gradient" aria-hidden="true"></span>
        <h2 class="mt-5 text-3xl md:text-4xl font-semibold text-neutral-dark leading-tight">
          Spesialis Data untuk Akuntansi &amp; Keuangan
        </h2>
        <p class="mt-6 text-base md:text-lg text-neutral-dark/70 leading-relaxed">
          Berbeda dengan konsultan data pada umumnya, Analyset fokus pada
          kebutuhan spesifik korporat menengah di bidang akuntansi dan keuangan
          — dari rekonsiliasi otomatis hingga model prediksi keuangan.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-6">
        <div class="group bg-white rounded-2xl card-shadow p-6 border border-gray-100 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-xl hover:shadow-primary/10">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
            <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-6M22 20H2"></path></svg>
          </span>
          <p class="mt-4 text-2xl font-bold text-gradient">Akuntansi</p>
          <p class="mt-2 text-sm text-neutral-dark/70">Spesialisasi utama kami</p>
        </div>
        <div class="group bg-white rounded-2xl card-shadow p-6 border border-gray-100 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-xl hover:shadow-primary/10">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
            <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"></path></svg>
          </span>
          <p class="mt-4 text-2xl font-bold text-gradient">Keuangan</p>
          <p class="mt-2 text-sm text-neutral-dark/70">Akurasi &amp; efisiensi data</p>
        </div>
        <div class="group bg-white rounded-2xl card-shadow p-6 border border-gray-100 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-xl hover:shadow-primary/10">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
            <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h.01M9 13h.01M15 9h.01M15 13h.01"></path></svg>
          </span>
          <p class="mt-4 text-2xl font-bold text-gradient">Korporat</p>
          <p class="mt-2 text-sm text-neutral-dark/70">Menengah sebagai fokus</p>
        </div>
        <div class="group bg-white rounded-2xl card-shadow p-6 border border-gray-100 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-xl hover:shadow-primary/10">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
            <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9M12 3a9 9 0 0 1 9 9M12 7v5l3 2"></path></svg>
          </span>
          <p class="mt-4 text-2xl font-bold text-gradient">Data</p>
          <p class="mt-2 text-sm text-neutral-dark/70">Pendekatan data-driven</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Preview -->
  <section class="py-16 md:py-24 bg-neutral-light">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
        <div>
          <span class="block h-1 w-16 rounded-full bg-brand-gradient" aria-hidden="true"></span>
          <h2 class="mt-5 text-3xl md:text-4xl font-semibold text-neutral-dark">
            Insight &amp; Artikel
          </h2>
          <p class="mt-4 text-base md:text-lg text-neutral-dark/70 max-w-2xl">
            Wawasan seputar data analytics, machine learning, automation, dan
            akuntansi-keuangan untuk korporat menengah.
          </p>
        </div>
        <a
          href="/blog/"
          class="text-primary font-medium hover:text-primary-dark transition-colors whitespace-nowrap"
        >
          Lihat semua artikel →
        </a>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        {
          latestPosts.map((post) => (
            <BlogCard
              href={`/blog/${post.slug}/`}
              title={post.data.title}
              excerpt={post.data.description}
              date={post.data.pubDate}
              tags={post.data.tags}
              image={post.data.image}
            />
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection title="Siap Mengoptimalkan Data Perusahaan Anda?" />
</Layout>
