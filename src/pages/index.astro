---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import CtaSection from '../components/CtaSection.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import BlogCard from '../components/BlogCard.astro';
import { services } from '../data/services';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestPosts = posts.slice(0, 3);
---

<Layout
  title="Konsultan Data Analytics Indonesia"
  description="Analyset membantu korporat menengah mengolah data menjadi keputusan bisnis — via machine learning, data analytics, automation & aplikasi. Konsultasi gratis."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-space-950 via-space-900 to-space-950 text-white">
    <div class="absolute inset-0 bg-starfield" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-grid-space opacity-70" aria-hidden="true"></div>
    <div
      class="absolute -top-24 -left-24 h-[22rem] w-[22rem] rounded-full bg-primary/30 blur-3xl opacity-60"
      aria-hidden="true"
    ></div>
    <div
      class="absolute top-16 right-0 h-[20rem] w-[20rem] rounded-full bg-cyan-400/15 blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="absolute bottom-0 left-1/3 h-56 w-56 rounded-full bg-sky-500/10 blur-3xl"
      aria-hidden="true"
    ></div>

    <!-- floating bubbles -->
    <div class="absolute top-1/4 left-[12%] h-4 w-4 rounded-full border border-cyan-300/40 animate-float" aria-hidden="true"></div>
    <div class="absolute top-1/3 right-[16%] h-6 w-6 rounded-full border border-sky-400/30 animate-float-slow" aria-hidden="true"></div>
    <div class="absolute bottom-1/4 left-[28%] h-3 w-3 rounded-full border border-cyan-200/40 animate-float-slow" aria-hidden="true"></div>
    <div class="absolute top-2/3 right-[30%] h-5 w-5 rounded-full border border-cyan-400/30 animate-float" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16 grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-10 items-center">
      <div class="animate-fade-in-up">
        <span class="inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/5 px-4 py-1.5 text-xs md:text-sm font-medium text-cyan-300 tracking-[0.2em] uppercase backdrop-blur">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan-400 animate-pulse" aria-hidden="true"></span>
          Konsultan Data Analytics
        </span>
        <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-white">
          Ubah Data Perusahaan Anda Menjadi Keputusan Bisnis yang
          <span class="text-gradient-cyan text-glow">Lebih Cerdas</span>
        </h1>
        <p class="mt-4 text-base md:text-lg text-white/70 leading-relaxed max-w-xl">
          Analyset membantu korporat menengah mengolah data menjadi rekomendasi
          bisnis nyata — melalui data analytics, machine learning, automation,
          dan pengembangan aplikasi.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/contact/"
            class="bg-cyan-gradient text-white rounded-xl px-6 py-3 font-medium glow-cyan animate-pulse-glow hover:-translate-y-0.5 transition-all duration-300"
          >
            Konsultasi Gratis
          </a>
          <a
            href="/services/"
            class="border border-cyan-400/40 text-cyan-200 rounded-xl px-6 py-3 font-medium backdrop-blur hover:bg-cyan-400/10 hover:border-cyan-300 hover:text-cyan-100 transition-all duration-300"
          >
            Lihat Layanan
          </a>
        </div>
      </div>

      <div class="hidden lg:block animate-fade-in-up delay-200">
        <div class="relative rounded-[2rem] glass glow-cyan p-5 md:p-6">
          <div class="absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-cyan-400/40 to-transparent" aria-hidden="true"></div>
          <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-cyan-400 glow-cyan"></span>
              <span class="text-sm font-medium text-white">Dashboard Analitik</span>
            </div>
            <span class="text-xs font-medium text-cyan-300 bg-cyan-400/10 border border-cyan-400/20 rounded-full px-3 py-1">
              Real-time
            </span>
          </div>
          <div class="flex items-end justify-between gap-3 h-32">
            <div class="w-full rounded-t-lg h-12 bg-gradient-to-t from-cyan-500/10 to-cyan-400/40"></div>
            <div class="w-full rounded-t-lg h-20 bg-gradient-to-t from-cyan-500/10 to-cyan-400/50"></div>
            <div class="w-full rounded-t-lg h-16 bg-gradient-to-t from-cyan-500/10 to-cyan-400/55"></div>
            <div class="w-full rounded-t-lg h-24 bg-gradient-to-t from-cyan-500/10 to-cyan-400/70"></div>
            <div class="w-full rounded-t-lg h-20 bg-gradient-to-t from-cyan-500/10 to-sky-400/80"></div>
            <div class="w-full rounded-t-lg h-32 bg-gradient-to-t from-cyan-500/10 to-cyan-300"></div>
          </div>
          <div class="mt-5 grid grid-cols-3 gap-3">
            <div class="rounded-xl bg-white/5 border border-cyan-400/15 p-3">
              <p class="text-xs text-white/60">Waktu dihemat</p>
              <p class="mt-1 text-xl font-bold text-gradient-cyan">100 jam</p>
            </div>
            <div class="rounded-xl bg-white/5 border border-cyan-400/15 p-3">
              <p class="text-xs text-white/60">Akurasi data</p>
              <p class="mt-1 text-xl font-bold text-gradient-cyan">99%</p>
            </div>
            <div class="rounded-xl bg-white/5 border border-cyan-400/15 p-3">
              <p class="text-xs text-white/60">Proses otomatis</p>
              <p class="mt-1 text-xl font-bold text-gradient-cyan">4+</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="relative py-12 md:py-16 bg-space-900">
    <div class="absolute inset-0 bg-starfield opacity-40" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <span class="inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-cyan-300">
          Layanan Kami
        </span>
        <h2 class="mt-4 text-3xl md:text-4xl font-semibold text-white">
          Layanan Kami
        </h2>
        <p class="mt-3 text-base md:text-lg text-white/70">
          Empat lini layanan yang dirancang untuk membantu korporat menengah
          mengoptimalkan data mereka.
        </p>
      </div>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        {
          services.map((service) => (
            <div class="group relative rounded-[1.5rem] glass p-5 md:p-6 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400/40 hover:glow-cyan overflow-hidden">
              <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-400/50 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></span>
              <div class="flex items-center justify-between">
                <div class="rounded-full glass-strong p-3 ring-1 ring-cyan-400/30 glow-cyan-soft transition-all duration-300 group-hover:ring-cyan-300/60">
                  <ServiceIcon id={service.id} class="h-8 w-8" />
                </div>
                <span class="text-cyan-300 transition-transform duration-300 group-hover:translate-x-1">→</span>
              </div>
              <h3 class="mt-4 text-xl md:text-2xl font-semibold text-white group-hover:text-cyan-300 transition-colors">
                {service.title}
              </h3>
              <p class="mt-3 text-base text-white/70 leading-relaxed">
                {service.description}
              </p>
              <a
                href={`/services/#${service.id}`}
                class="mt-4 inline-block text-sm font-medium text-cyan-300 hover:text-sky-300 transition-colors"
              >
                Pelajari lebih lanjut →
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Case Study Highlight -->
  <section class="py-12 md:py-16 bg-space-950">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="rounded-[2rem] glass-strong glow-cyan overflow-hidden grid grid-cols-1 lg:grid-cols-2">
        <div class="relative p-6 md:p-10 flex flex-col justify-center text-white overflow-hidden">
          <div class="absolute inset-0 bg-cyan-gradient opacity-90" aria-hidden="true"></div>
          <div class="absolute inset-0 bg-grid-light opacity-30" aria-hidden="true"></div>
          <div class="absolute -top-16 -right-16 h-64 w-64 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
          <div class="relative">
            <p class="text-sm font-medium uppercase tracking-wider text-white/85">
              Studi Kasus
            </p>
            <p class="mt-4 text-4xl md:text-5xl font-bold leading-tight text-white">
              100 Jam Kerja/Minggu Dihemat
            </p>
            <p class="mt-3 text-white/90 leading-relaxed">
              Kopi Kenangan — Automation Rekonsiliasi Keuangan
            </p>
          </div>
        </div>
        <div class="p-6 md:p-10 flex flex-col justify-center">
          <span class="block h-1 w-16 rounded-full bg-cyan-gradient" aria-hidden="true"></span>
          <h2 class="mt-4 text-2xl md:text-3xl font-semibold text-white">
            Kopi Kenangan
          </h2>
          <p class="mt-3 text-base md:text-lg text-white/70 leading-relaxed">
            Kami membantu Kopi Kenangan mengotomatisasi proses rekonsiliasi
            keuangan, memangkas waktu kerja manual secara signifikan setiap
            minggunya.
          </p>
          <a
            href="/case-study/"
            class="mt-4 inline-block text-cyan-300 font-medium hover:text-sky-300 transition-colors"
          >
            Baca Studi Kasus Lengkap →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Analyset -->
  <section class="py-12 md:py-16 bg-space-900">
    <div class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-10 items-center">
      <div>
        <span class="block h-1 w-16 rounded-full bg-cyan-gradient" aria-hidden="true"></span>
        <h2 class="mt-4 text-3xl md:text-4xl font-semibold text-white leading-tight">
          Spesialis Data untuk Akuntansi &amp; Keuangan
        </h2>
        <p class="mt-4 text-base md:text-lg text-white/70 leading-relaxed">
          Berbeda dengan konsultan data pada umumnya, Analyset fokus pada
          kebutuhan spesifik korporat menengah di bidang akuntansi dan keuangan
          — dari rekonsiliasi otomatis hingga model prediksi keuangan.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="group rounded-[1.5rem] glass p-5 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400/40 hover:glow-cyan">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full glass-strong ring-1 ring-cyan-400/30">
            <svg class="h-5 w-5 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-6M22 20H2"></path></svg>
          </span>
          <p class="mt-3 text-2xl font-bold text-gradient-cyan">Akuntansi</p>
          <p class="mt-2 text-sm text-white/60">Spesialisasi utama kami</p>
        </div>
        <div class="group rounded-[1.5rem] glass p-5 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400/40 hover:glow-cyan">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full glass-strong ring-1 ring-cyan-400/30">
            <svg class="h-5 w-5 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"></path></svg>
          </span>
          <p class="mt-3 text-2xl font-bold text-gradient-cyan">Keuangan</p>
          <p class="mt-2 text-sm text-white/60">Akurasi &amp; efisiensi data</p>
        </div>
        <div class="group rounded-[1.5rem] glass p-5 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400/40 hover:glow-cyan">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full glass-strong ring-1 ring-cyan-400/30">
            <svg class="h-5 w-5 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h.01M9 13h.01M15 9h.01M15 13h.01"></path></svg>
          </span>
          <p class="mt-3 text-2xl font-bold text-gradient-cyan">Korporat</p>
          <p class="mt-2 text-sm text-white/60">Menengah sebagai fokus</p>
        </div>
        <div class="group rounded-[1.5rem] glass p-5 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400/40 hover:glow-cyan">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full glass-strong ring-1 ring-cyan-400/30">
            <svg class="h-5 w-5 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9M12 3a9 9 0 0 1 9 9M12 7v5l3 2"></path></svg>
          </span>
          <p class="mt-3 text-2xl font-bold text-gradient-cyan">Data</p>
          <p class="mt-2 text-sm text-white/60">Pendekatan data-driven</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Preview -->
  <section class="py-12 md:py-16 bg-space-950">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
        <div>
          <span class="block h-1 w-16 rounded-full bg-cyan-gradient" aria-hidden="true"></span>
          <h2 class="mt-4 text-3xl md:text-4xl font-semibold text-white">
            Insight &amp; Artikel
          </h2>
          <p class="mt-3 text-base md:text-lg text-white/70 max-w-2xl">
            Wawasan seputar data analytics, machine learning, automation, dan
            akuntansi-keuangan untuk korporat menengah.
          </p>
        </div>
        <a
          href="/blog/"
          class="text-cyan-300 font-medium hover:text-sky-300 transition-colors whitespace-nowrap"
        >
          Lihat semua artikel →
        </a>
      </div>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
        {
          latestPosts.map((post) => (
            <BlogCard
              href={`/blog/${post.slug}/`}
              title={post.data.title}
              excerpt={post.data.description}
              date={post.data.pubDate}
              tags={post.data.tags}
              image={post.data.image}
            />
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection title="Siap Mengoptimalkan Data Perusahaan Anda?" />
</Layout>
