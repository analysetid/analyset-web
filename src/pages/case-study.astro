---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://analyset.id/' },
    { '@type': 'ListItem', position: 2, name: 'Studi Kasus', item: 'https://analyset.id/case-study/' },
  ],
};
---

<Layout
  title="Studi Kasus Automation Rekonsiliasi Keuangan"
  description="Studi kasus automation rekonsiliasi keuangan Kopi Kenangan: hemat 100 jam kerja per minggu. Pelajari bagaimana Analyset mengotomatisasi proses finance klien."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="relative overflow-hidden bg-neutral-light py-16 md:py-24">
    <div class="absolute inset-0 bg-dots opacity-40" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <span class="mx-auto block h-1 w-16 rounded-full bg-brand-gradient" aria-hidden="true"></span>
        <h1 class="mt-5 text-4xl md:text-5xl font-bold text-neutral-dark">
          Studi Kasus
        </h1>
        <p class="mt-4 text-base md:text-lg text-neutral-dark/70">
          Bukti nyata bagaimana Analyset membantu bisnis mengoptimalkan proses
          melalui data.
        </p>
      </div>
    </div>
  </section>

  <!-- Kopi Kenangan Case Study -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <!-- TODO: izin publikasi nama & angka "Kopi Kenangan" perlu konfirmasi Arseno sebelum go-live -->
      <div class="bg-white rounded-3xl card-shadow border border-gray-100 p-8 md:p-12">
        <div class="border-b border-gray-100 pb-8 mb-10">
          <span class="text-xs font-semibold uppercase tracking-wider text-primary">
            Flagship Case Study
          </span>
          <h2 class="mt-3 text-2xl md:text-3xl font-semibold text-neutral-dark">
            Kopi Kenangan — Automation Rekonsiliasi Keuangan
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
          <div class="group relative bg-neutral-light rounded-2xl p-6 border border-gray-100 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/10 overflow-hidden">
            <span class="absolute inset-x-0 top-0 h-1 bg-brand-gradient opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></span>
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand-gradient text-white font-bold">1</span>
            <h3 class="mt-4 text-lg font-semibold text-neutral-dark">Problem</h3>
            <p class="mt-3 text-neutral-dark/70 leading-relaxed">
              Kopi Kenangan menghadapi tantangan proses rekonsiliasi keuangan
              manual yang memakan waktu tim finance secara signifikan setiap
              minggunya, meningkatkan risiko human error dan menghambat
              efisiensi operasional.
            </p>
          </div>
          <div class="group relative bg-neutral-light rounded-2xl p-6 border border-gray-100 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/10 overflow-hidden">
            <span class="absolute inset-x-0 top-0 h-1 bg-brand-gradient opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></span>
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand-gradient text-white font-bold">2</span>
            <h3 class="mt-4 text-lg font-semibold text-neutral-dark">Solution</h3>
            <p class="mt-3 text-neutral-dark/70 leading-relaxed">
              Analyset merancang dan mengimplementasikan sistem automation
              rekonsiliasi yang mengotomatisasi proses pencocokan data
              transaksi, menggantikan pekerjaan manual berulang dengan alur
              kerja otomatis.
            </p>
          </div>
          <div class="group relative bg-neutral-light rounded-2xl p-6 border border-gray-100 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/10 overflow-hidden">
            <span class="absolute inset-x-0 top-0 h-1 bg-brand-gradient opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></span>
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand-gradient text-white font-bold">3</span>
            <h3 class="mt-4 text-lg font-semibold text-neutral-dark">Result</h3>
            <p class="mt-3 text-neutral-dark/70 leading-relaxed">
              Implementasi automation ini berhasil menghemat waktu kerja tim
              finance Kopi Kenangan — waktu yang sebelumnya dihabiskan untuk
              rekonsiliasi manual kini dapat dialokasikan untuk pekerjaan yang
              lebih strategis.
            </p>
          </div>
        </div>

        <div class="relative overflow-hidden mt-10 bg-brand-gradient rounded-2xl p-8 md:p-12 text-white text-center glow-blue">
          <div class="absolute inset-0 bg-grid-light opacity-40" aria-hidden="true"></div>
          <div class="absolute -top-16 left-1/2 -translate-x-1/2 h-64 w-64 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
          <div class="relative">
            <p class="text-sm font-medium uppercase tracking-wider text-white/80">
              Hasil Terukur
            </p>
            <p class="mt-3 text-5xl md:text-6xl font-bold leading-none text-white">
              100 Jam
            </p>
            <p class="mt-3 text-lg md:text-xl font-medium text-white/90">
              kerja per minggu dihemat
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaSection
    title="Ingin hasil serupa untuk bisnis Anda? Konsultasi Gratis Sekarang"
    buttonLabel="Konsultasi Gratis"
  />
</Layout>
