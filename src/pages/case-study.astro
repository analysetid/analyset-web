---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://analyset.com/' },
    { '@type': 'ListItem', position: 2, name: 'Studi Kasus', item: 'https://analyset.com/case-study/' },
  ],
};
---

<Layout
  title="Studi Kasus Automation Rekonsiliasi Keuangan"
  description="Studi kasus automation rekonsiliasi keuangan Kopi Kenangan: hemat 100 jam kerja per minggu. Pelajari bagaimana Analyset mengotomatisasi proses finance klien."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="relative overflow-hidden bg-gradient-to-b from-space-950 to-space-900 py-10 md:py-14">
    <div class="absolute inset-0 bg-starfield opacity-60" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-grid-space opacity-60" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <span class="inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-cyan-300">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan-400" aria-hidden="true"></span>
          Studi Kasus
        </span>
        <h1 class="mt-4 text-4xl md:text-5xl font-bold text-white">
          Studi Kasus
        </h1>
        <p class="mt-3 text-base md:text-lg text-white/70">
          Bukti nyata bagaimana Analyset membantu bisnis mengoptimalkan proses
          melalui data.
        </p>
      </div>
    </div>
  </section>

  <!-- Kopi Kenangan Case Study -->
  <section class="py-12 md:py-16 bg-space-950">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <!-- TODO: izin publikasi nama & angka "Kopi Kenangan" perlu konfirmasi Arseno sebelum go-live -->
      <div class="rounded-[2rem] glass-strong glow-cyan p-6 md:p-10">
        <div class="border-b border-cyan-400/15 pb-6 mb-8">
          <span class="text-xs font-semibold uppercase tracking-widest text-cyan-300">
            Flagship Case Study
          </span>
          <h2 class="mt-3 text-2xl md:text-3xl font-semibold text-white">
            Kopi Kenangan — Automation Rekonsiliasi Keuangan
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 md:gap-6">
          <div class="group relative rounded-[1.5rem] glass p-5 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400/40 hover:glow-cyan overflow-hidden">
            <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-400/50 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></span>
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-cyan-gradient text-white font-bold glow-cyan-soft">1</span>
            <h3 class="mt-3 text-lg font-semibold text-white">Problem</h3>
            <p class="mt-2 text-white/70 leading-relaxed">
              Kopi Kenangan menghadapi tantangan proses rekonsiliasi keuangan
              manual yang memakan waktu tim finance secara signifikan setiap
              minggunya, meningkatkan risiko human error dan menghambat
              efisiensi operasional.
            </p>
          </div>
          <div class="group relative rounded-[1.5rem] glass p-5 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400/40 hover:glow-cyan overflow-hidden">
            <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-400/50 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></span>
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-cyan-gradient text-white font-bold glow-cyan-soft">2</span>
            <h3 class="mt-3 text-lg font-semibold text-white">Solution</h3>
            <p class="mt-2 text-white/70 leading-relaxed">
              Analyset merancang dan mengimplementasikan sistem automation
              rekonsiliasi yang mengotomatisasi proses pencocokan data
              transaksi, menggantikan pekerjaan manual berulang dengan alur
              kerja otomatis.
            </p>
          </div>
          <div class="group relative rounded-[1.5rem] glass p-5 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400/40 hover:glow-cyan overflow-hidden">
            <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-400/50 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></span>
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-cyan-gradient text-white font-bold glow-cyan-soft">3</span>
            <h3 class="mt-3 text-lg font-semibold text-white">Result</h3>
            <p class="mt-2 text-white/70 leading-relaxed">
              Implementasi automation ini berhasil menghemat waktu kerja tim
              finance Kopi Kenangan — waktu yang sebelumnya dihabiskan untuk
              rekonsiliasi manual kini dapat dialokasikan untuk pekerjaan yang
              lebih strategis.
            </p>
          </div>
        </div>

        <div class="relative overflow-hidden mt-8 rounded-[1.5rem] glass-strong p-6 md:p-10 text-white text-center glow-cyan">
          <div class="absolute inset-0 bg-cyan-gradient opacity-15" aria-hidden="true"></div>
          <div class="absolute inset-0 bg-starfield opacity-50" aria-hidden="true"></div>
          <div class="absolute -top-16 left-1/2 -translate-x-1/2 h-64 w-64 rounded-full bg-cyan-400/15 blur-3xl" aria-hidden="true"></div>
          <div class="relative">
            <p class="text-sm font-medium uppercase tracking-widest text-cyan-300">
              Hasil Terukur
            </p>
            <p class="mt-3 text-5xl md:text-6xl font-bold leading-none text-gradient-cyan text-glow">
              100 Jam
            </p>
            <p class="mt-3 text-lg md:text-xl font-medium text-white/85">
              kerja per minggu dihemat
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaSection
    title="Ingin hasil serupa untuk bisnis Anda? Konsultasi Gratis Sekarang"
    buttonLabel="Konsultasi Gratis"
  />
</Layout>
