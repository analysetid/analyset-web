---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Hubungi Kami"
  description="Hubungi Analyset untuk konsultasi data & analitik bisnis gratis. Kirim pesan via form kontak atau email central@analyset.com untuk kebutuhan perusahaan Anda."
>
  <section class="relative overflow-hidden bg-gradient-to-b from-sky-50 to-white py-10 md:py-14">
    <div class="absolute inset-0 bg-dots" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <span class="inline-flex items-center gap-2 rounded-full border border-sky-300 bg-sky-50 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-primary">
          <span class="h-1.5 w-1.5 rounded-full bg-sky-500" aria-hidden="true"></span>
          Kontak
        </span>
        <h1 class="mt-4 text-4xl md:text-5xl font-bold text-neutral-dark">
          Hubungi Kami
        </h1>
        <p class="mt-3 text-base md:text-lg text-gray-600">
          Konsultasikan kebutuhan data dan analitik bisnis Anda dengan tim
          Analyset — gratis, tanpa komitmen.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
      <div class="lg:col-span-2">
        <!-- TODO: mekanisme submit form (backend/Formspree/Resend) perlu keputusan Arseno -->
        <form id="contact-form" class="rounded-[1.5rem] bg-white border border-sky-100 shadow-md p-6 md:p-7" novalidate>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                Nama Lengkap
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Nama Anda"
                class="w-full rounded-xl border border-sky-200 bg-white px-4 py-3 text-neutral-dark placeholder-gray-400 focus:ring-2 focus:ring-sky-400/60 focus:border-sky-400 outline-none transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="email@perusahaan.com"
                class="w-full rounded-xl border border-sky-200 bg-white px-4 py-3 text-neutral-dark placeholder-gray-400 focus:ring-2 focus:ring-sky-400/60 focus:border-sky-400 outline-none transition-colors"
              />
            </div>
          </div>
          <div class="mt-4">
            <label for="company" class="block text-sm font-medium text-gray-700 mb-2">
              Nama Perusahaan
            </label>
            <input
              id="company"
              name="company"
              type="text"
              autocomplete="organization"
              placeholder="Nama perusahaan Anda"
              class="w-full rounded-xl border border-sky-200 bg-white px-4 py-3 text-neutral-dark placeholder-gray-400 focus:ring-2 focus:ring-sky-400/60 focus:border-sky-400 outline-none transition-colors"
            />
          </div>
          <div class="mt-4">
            <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
              Pesan / Kebutuhan Anda
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Ceritakan kebutuhan data & analitik bisnis Anda"
              class="w-full rounded-xl border border-sky-200 bg-white px-4 py-3 text-neutral-dark placeholder-gray-400 focus:ring-2 focus:ring-sky-400/60 focus:border-sky-400 outline-none transition-colors resize-y"
            ></textarea>
          </div>
          <button
            type="submit"
            class="mt-5 bg-brand-gradient text-white rounded-xl px-6 py-3 font-medium shadow-lg shadow-primary/25 hover:-translate-y-0.5 transition-all duration-300"
          >
            Kirim Pesan
          </button>

          <p id="form-error" class="hidden mt-3 text-sm text-red-500">
            Mohon lengkapi semua kolom wajib dengan benar.
          </p>
        </form>

        <div
          id="form-success"
          class="hidden rounded-[1.5rem] bg-white border border-sky-100 shadow-md p-6 md:p-8"
        >
          <div class="flex items-start gap-4">
            <div class="rounded-full bg-sky-50 ring-1 ring-sky-200 p-3">
              <svg
                class="h-6 w-6 text-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-lg font-semibold text-neutral-dark">
                Pesan terkirim
              </h2>
              <p class="mt-2 text-gray-600">
                Terima kasih telah menghubungi Analyset. Tim kami akan merespons
                pesan Anda secepatnya.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-4">
        <div class="rounded-[1.5rem] bg-white border border-sky-100 shadow-md p-6">
          <h2 class="text-lg font-semibold text-neutral-dark">Info Kontak</h2>
          <ul class="mt-4 space-y-4 text-gray-600">
            <li class="flex items-start gap-3">
              <svg
                class="h-5 w-5 text-primary shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 6h16v12H4zM4 6l8 7 8-7"></path>
              </svg>
              <a href="mailto:central@analyset.com" class="hover:text-primary transition-colors">
                central@analyset.com
              </a>
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="h-5 w-5 text-primary shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 5c0 8 7 15 15 15l2-3-4-2-2 1a12 12 0 0 1-5-5l1-2-2-4-3 2z"></path>
              </svg>
              <a
                href="https://wa.me/6281363663754"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-primary transition-colors"
              >
                +62 813-6363-754 (WhatsApp)
              </a>
            </li>
          </ul>
        </div>

        <div class="relative overflow-hidden rounded-[1.5rem] bg-cyan-gradient p-6 text-white shadow-lg shadow-primary/25">
          <div class="absolute inset-0 bg-grid-light opacity-30" aria-hidden="true"></div>
          <div class="relative">
            <h2 class="text-lg font-semibold">Butuh bantuan lebih cepat?</h2>
            <p class="mt-2 text-sm text-white/85">
              Tim kami siap membantu mendiskusikan kebutuhan data &amp; analitik
              bisnis Anda.
            </p>
            <div class="mt-3 flex flex-col gap-3">
              <a
                href="https://wa.me/6281363663754"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 bg-whatsapp text-white rounded-xl px-6 py-3 font-semibold hover:bg-whatsapp-dark hover:-translate-y-0.5 transition-all duration-300 text-sm shadow-lg shadow-whatsapp/30"
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
                </svg>
                Chat WhatsApp
              </a>
              <a
                href="mailto:central@analyset.com"
                class="inline-block text-center text-sm text-white/85 hover:text-white transition-colors"
              >
                atau kirim email: central@analyset.com
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form');
  const success = document.getElementById('form-success');
  const error = document.getElementById('form-error');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    error?.classList.add('hidden');

    if (!form.checkValidity()) {
      error?.classList.remove('hidden');
      return;
    }

    form.classList.add('hidden');
    success?.classList.remove('hidden');
  });
</script>
