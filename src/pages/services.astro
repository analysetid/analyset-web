---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { services } from '../data/services';

const [featured, ...rest] = services;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://analyset.com/' },
    { '@type': 'ListItem', position: 2, name: 'Layanan', item: 'https://analyset.com/services/' },
  ],
};
---

<Layout
  title="Layanan: Machine Learning & Data Analytics"
  description="Jasa machine learning, implementasi data analytics, automation proses keuangan, dan pengembangan aplikasi untuk korporat. Konsultasikan kebutuhan Anda."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="relative overflow-hidden bg-gradient-to-b from-sky-50 to-white py-10 md:py-14">
    <div class="absolute inset-0 bg-dots" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <span class="inline-flex items-center gap-2 rounded-full border border-sky-300 bg-sky-50 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-primary">
          <span class="h-1.5 w-1.5 rounded-full bg-sky-500" aria-hidden="true"></span>
          Layanan
        </span>
        <h1 class="mt-4 text-4xl md:text-5xl font-bold text-neutral-dark">
          Layanan Kami
        </h1>
        <p class="mt-3 text-base md:text-lg text-gray-600">
          Empat lini layanan yang dirancang untuk membantu korporat
          mengoptimalkan data mereka.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 md:px-8 flex flex-col gap-8">
      <!-- Featured: Machine Learning -->
      <div id={featured.id} class="relative overflow-hidden rounded-[2rem] bg-cyan-gradient p-6 md:p-10 text-white shadow-lg shadow-primary/25">
        <div class="absolute inset-0 bg-grid-light opacity-30" aria-hidden="true"></div>
        <div class="absolute -top-20 -right-20 h-64 w-64 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
        <div class="relative flex flex-col lg:flex-row gap-6 items-start">
          <div class="flex-1">
            <span class="inline-block text-xs font-semibold uppercase tracking-widest bg-white/15 border border-white/25 text-white rounded-full px-4 py-1.5">
              Layanan Andalan
            </span>
            <h2 class="mt-4 text-2xl md:text-3xl font-semibold leading-tight">
              {featured.title}
            </h2>
            <p class="mt-3 text-base md:text-lg text-white/85 leading-relaxed">
              {featured.detail}
            </p>
          </div>
          <div class="w-full lg:w-64 rounded-2xl bg-white/10 border border-white/20 p-5">
            <ServiceIcon id={featured.id} class="h-12 w-12 text-white" variant="solid" />
          </div>
        </div>
        <ul class="relative mt-6 grid grid-cols-1 md:grid-cols-2 gap-3">
          {featured.bullets.map((bullet) => (
            <li class="flex items-start gap-3 text-white/90">
              <svg
                class="h-5 w-5 text-sky-200 shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 13l4 4L19 7"></path>
              </svg>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Remaining services -->
      {
        rest.map((service) => (
          <div
            id={service.id}
            class="group relative rounded-[1.5rem] bg-white border border-sky-100 shadow-md p-6 md:p-8 transition-all duration-300 hover:border-sky-300 hover:shadow-lg overflow-hidden"
          >
            <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sky-400/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></span>
            <div class="flex items-start gap-5">
              <div class="rounded-full bg-sky-50 p-3 ring-1 ring-sky-200 transition-all duration-300 group-hover:ring-sky-300 shrink-0">
                <ServiceIcon id={service.id} class="h-8 w-8" />
              </div>
              <div>
                <h2 class="text-xl md:text-2xl font-semibold text-neutral-dark group-hover:text-primary transition-colors">
                  {service.title}
                </h2>
                <p class="mt-3 text-base md:text-lg text-gray-600 leading-relaxed">
                  {service.detail}
                </p>
              </div>
            </div>
            <ul class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-3">
              {service.bullets.map((bullet) => (
                <li class="flex items-start gap-3 text-gray-600">
                  <svg
                    class="h-5 w-5 text-primary shrink-0 mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <CtaSection
    title="Butuh solusi khusus untuk bisnis Anda? Konsultasikan kebutuhan Anda dengan tim kami."
    buttonLabel="Konsultasi Gratis"
  />
</Layout>
