---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { services } from '../data/services';

const [featured, ...rest] = services;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://analyset.com/' },
    { '@type': 'ListItem', position: 2, name: 'Layanan', item: 'https://analyset.com/services/' },
  ],
};
---

<Layout
  title="Layanan: Machine Learning & Data Analytics"
  description="Jasa machine learning, implementasi data analytics, automation proses keuangan, dan pengembangan aplikasi untuk korporat menengah. Konsultasikan kebutuhan Anda."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="relative overflow-hidden bg-gradient-to-b from-space-950 to-space-900 py-16 md:py-24">
    <div class="absolute inset-0 bg-starfield opacity-60" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-grid-space opacity-60" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <span class="inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-cyan-300">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan-400" aria-hidden="true"></span>
          Layanan
        </span>
        <h1 class="mt-5 text-4xl md:text-5xl font-bold text-white">
          Layanan Kami
        </h1>
        <p class="mt-4 text-base md:text-lg text-white/70">
          Empat lini layanan yang dirancang untuk membantu korporat menengah
          mengoptimalkan data mereka.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-space-950">
    <div class="max-w-7xl mx-auto px-4 md:px-8 flex flex-col gap-16">
      <!-- Featured: Machine Learning -->
      <div id={featured.id} class="relative overflow-hidden rounded-[2rem] glass-strong glow-cyan p-8 md:p-12 text-white">
        <div class="absolute inset-0 bg-cyan-gradient opacity-10" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-grid-light opacity-30" aria-hidden="true"></div>
        <div class="absolute -top-20 -right-20 h-64 w-64 rounded-full bg-cyan-400/15 blur-3xl" aria-hidden="true"></div>
        <div class="relative flex flex-col lg:flex-row gap-8 items-start">
          <div class="flex-1">
            <span class="inline-block text-xs font-semibold uppercase tracking-widest bg-cyan-400/10 border border-cyan-400/30 text-cyan-300 rounded-full px-4 py-1.5">
              Layanan Andalan
            </span>
            <h2 class="mt-5 text-2xl md:text-3xl font-semibold leading-tight">
              {featured.title}
            </h2>
            <p class="mt-4 text-base md:text-lg text-white/80 leading-relaxed">
              {featured.detail}
            </p>
          </div>
          <div class="w-full lg:w-64 rounded-2xl glass p-6">
            <ServiceIcon id={featured.id} class="h-12 w-12 text-white" variant="solid" />
          </div>
        </div>
        <ul class="relative mt-8 grid grid-cols-1 md:grid-cols-2 gap-3">
          {featured.bullets.map((bullet) => (
            <li class="flex items-start gap-3 text-white/90">
              <svg
                class="h-5 w-5 text-cyan-300 shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 13l4 4L19 7"></path>
              </svg>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Remaining services -->
      {
        rest.map((service) => (
          <div
            id={service.id}
            class="group relative rounded-[1.5rem] glass p-8 md:p-10 transition-all duration-300 hover:border-cyan-400/40 hover:glow-cyan overflow-hidden"
          >
            <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-400/50 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></span>
            <div class="flex items-start gap-5">
              <div class="rounded-full glass-strong p-3 ring-1 ring-cyan-400/30 glow-cyan-soft transition-all duration-300 group-hover:ring-cyan-300/60 shrink-0">
                <ServiceIcon id={service.id} class="h-8 w-8" />
              </div>
              <div>
                <h2 class="text-xl md:text-2xl font-semibold text-white group-hover:text-cyan-300 transition-colors">
                  {service.title}
                </h2>
                <p class="mt-3 text-base md:text-lg text-white/70 leading-relaxed">
                  {service.detail}
                </p>
              </div>
            </div>
            <ul class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-3">
              {service.bullets.map((bullet) => (
                <li class="flex items-start gap-3 text-white/75">
                  <svg
                    class="h-5 w-5 text-cyan-300 shrink-0 mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <CtaSection
    title="Butuh solusi khusus untuk bisnis Anda? Konsultasikan kebutuhan Anda dengan tim kami."
    buttonLabel="Konsultasi Gratis"
  />
</Layout>
