---
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogImage?: string;
}

const {
  title,
  description,
  ogType = 'website',
  ogImage = '/og-image.png',
} = Astro.props;

const siteUrl = Astro.site?.href ?? 'https://analyset.com';
const canonical = new URL(Astro.url.pathname, siteUrl).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Analyset',
  url: 'https://analyset.com',
  logo: 'https://analyset.com/logos/analyset-logo.png',
  description:
    'Konsultan data analytics spesialis akuntansi & keuangan untuk korporat.',
  email: 'central@analyset.com',
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Analyset</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={`${title} | Analyset`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl.replace(/\/$/, '')}${ogImage}`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Analyset" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Analyset`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl.replace(/\/$/, '')}${ogImage}`} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <ClientRouter />

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-40ELCZH5Y3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-40ELCZH5Y3', { send_page_view: false });
      // Fire pageview on initial load AND every client-side view-transition navigation
      document.addEventListener('astro:page-load', () => {
        gtag('event', 'page_view', {
          page_location: window.location.href,
          page_path: window.location.pathname,
          page_title: document.title,
        });
      });
    </script>

    <script>
      // Reset scroll ke atas saat navigasi lewat ClientRouter.
      //
      // Dipasang di `astro:before-swap` (bukan after-swap/page-load): event ini
      // fire DI DALAM callback view transition, tepat sebelum DOM lama ditukar.
      // Jadi saat browser menangkap snapshot "new", scroll sudah di 0 dan
      // geometri elemen tidak perlu dianimasikan dari offset scroll lama.
      //
      // `event.navigationType` ('push' | 'replace' | 'traverse') adalah sinyal
      // resmi Astro untuk membedakan navigasi biasa dari back/forward, jadi
      // tidak perlu lagi melacak popstate atau mengutak-atik
      // history.scrollRestoration sendiri (ClientRouter sudah mengurusnya).
      //
      // `behavior: 'instant'` wajib eksplisit karena html punya
      // `scroll-behavior: smooth` global — tanpa itu scroll jadi animasi.
      document.addEventListener('astro:before-swap', (event) => {
        // Back/forward: biarkan Astro me-restore posisi scroll dari history state.
        if (event.navigationType === 'traverse') return;
        // Link ke anchor (#section): biarkan browser lompat ke section itu.
        if (event.to.hash) return;
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      });
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Navbar transition:persist />
    <main class="flex-1">
      <slot />
    </main>
    <Footer transition:persist />
    <a
      href="https://wa.me/6287855572616"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat WhatsApp Analyset"
      transition:persist
      class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-lg shadow-whatsapp/40 transition-transform duration-300 hover:scale-110"
    >
      <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
      </svg>
    </a>
  </body>
</html>
